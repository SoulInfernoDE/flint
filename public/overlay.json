{
  "id": "io.github.soulinfernode.flint",
  "version": "0.1.0",
  "name": "Flint",
  "description": "mod-description",
  "author": "SoulInfernoDE and contributors",
  "license": "GPL-3.0-or-later",
  "source": "https://github.com/SoulInfernoDE/flint",
  "games": ["hearthstone"],
  "permissions": ["game.state", "game.events", "storage"],
  "network": ["api.hearthstonejson.com", "art.hearthstonejson.com"],
  "windows": {
    "battlegrounds": {
      "kind": "overlay",
      "entry": "index.html",
      "width": 270,
      "height": 680,
      "position": {
        "x": 1645,
        "y": 120
      }
    },
    "minions": {
      "kind": "overlay",
      "entry": "minions.html",
      "width": 236,
      "height": 860,
      "position": {
        "x": 6,
        "y": 140
      }
    },
    "history": {
      "kind": "desktop",
      "entry": "history.html"
    },
    "deck": {
      "kind": "overlay",
      "entry": "deck.html",
      "width": 232,
      "height": 820,
      "position": {
        "x": 1680,
        "y": 140
      }
    }
  },
  "settings": [
    {
      "id": "show-board",
      "label": "setting-show-board",
      "type": "boolean",
      "default": true
    },
    {
      "id": "show-minions",
      "label": "setting-show-minions",
      "type": "boolean",
      "default": true
    },
    {
      "id": "show-deck",
      "label": "setting-show-deck",
      "type": "boolean",
      "default": true
    }
  ]
}
